/dist/

# Visual regression baselines are intentional PNG fixtures. Candidate captures
# and generated reports stay local.
visual-tests/current/
visual-tests/report/
!visual-tests/baseline/
!visual-tests/baseline/**/*.png

# Per-example visual baselines. `current` and `report` are regenerated locally.
tests/visual/**/current/
tests/visual/**/report/
!tests/
!tests/visual/
!tests/visual/**/
!tests/visual/**/baseline/
!tests/visual/**/baseline/**/*.png

# Source assets for self-contained visual examples. Generated SVG renders remain ignored.
!tests/assets/
!tests/assets/**/*.svg

# These must come after the parent-directory exceptions above.
tests/visual/**/current/
tests/visual/**/report/
