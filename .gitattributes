# Force LF everywhere so editor tooling and cross-platform work is consistent.
* text=auto eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.lock text eol=lf

# Binary files — never touch.
*.png  binary
*.jpg  binary
*.webp binary
*.mp4  binary
*.webm binary
*.svg  binary
*.gif  binary
